# Telegram notifications for messages, reservations, signups, and client errors.
# Recommended: deploy apps-script/telegram-proxy.gs as a web app and point the
# site at it, so the bot token never ships in the browser bundle.
VITE_TELEGRAM_PROXY_URL=
VITE_TELEGRAM_PROXY_KEY=

# Fallback for a quick local test without a proxy. Vite inlines these into the
# public bundle, so leave them empty on the deployed site.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
